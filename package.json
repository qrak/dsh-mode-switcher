{
  "name": "@qrak/dsh-mode-switcher",
  "version": "1.0.0",
  "description": "Tab toggles Plan/Build in DeepSeek Harness; each mode keeps its own model and reasoning preset across restarts.",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "engines": {
    "dsh": ">=0.2.0-rc.1"
  },
  "scripts": {
    "check": "node --check index.js && node --check client.js",
    "test": "node --test"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plan-mode",
    "build-mode",
    "model-switcher",
    "tab-shortcut"
  ],
  "author": "qrak",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qrak/dsh-mode-switcher.git"
  },
  "homepage": "https://github.com/qrak/dsh-mode-switcher#readme",
  "bugs": {
    "url": "https://github.com/qrak/dsh-mode-switcher/issues"
  }
}
